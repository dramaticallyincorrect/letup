{
  "name": "api",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "vitest run --mode test",
    "start": "pnpm run build:ts && node dist/server.js",
    "build:ts": "tsc",
    "dev": "tsx watch src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "drizzle-kit migrate --config drizzle.test.config.ts",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@fastify/autoload": "^6.0.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.7.0",
    "@google/generative-ai": "^0.24.1",
    "@paddle/paddle-node-sdk": "^3.8.0",
    "@scalar/fastify-api-reference": "^1.53.1",
    "@tailwindcss/node": "^4.2.4",
    "@types/pg": "^8.20.0",
    "better-auth": "^1.6.11",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "pg": "^8.20.0",
    "postgres": "^3.4.9",
    "vitest": "^4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "c8": "^11.0.0",
    "concurrently": "^9.0.0",
    "fastify-cli": "^8.0.0",
    "fastify-tsconfig": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.4.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
